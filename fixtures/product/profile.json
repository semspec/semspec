{
  "project": "Shop product",
  "iri": { "base": "https://example.org/shop/", "prefixes": { "ex": "https://example.org/ns/" } },
  "fieldIris": { "priority": "ex:priority" },
  "source": { "nodes": "nodes", "id": "id", "kind": "kind" },
  "fields": {
    "title": ["name", "short", "title"],
    "idPrefixPattern": "^[a-z]+-",
    "statement": ["summary", "quote"],
    "level": "priority",
    "delivery": "release",
    "decided": "decidedOn"
  },
  "lifecycle": {
    "field": "status",
    "fallback": "planned",
    "byKind": { "standard": "" },
    "states": { "dropped": { "muted": true }, "replaced": { "muted": true } }
  },
  "kinds": [
    { "id": "product", "label": "Product", "plural": "products", "prefix": "prd-", "role": "hierarchy", "color": { "light": "#5f3dc4", "dark": "#b197fc" }, "chips": ["lifecycle", "members"] },
    { "id": "epic", "iri": "ex:Epic", "label": "Epic", "plural": "epics", "prefix": "epic-", "role": "hierarchy", "parents": [["products"]], "color": { "light": "#1971c2", "dark": "#74c0fc" }, "chips": ["lifecycle", "members"] },
    {
      "id": "story",
      "iri": "ex:Story",
      "label": "Story",
      "plural": "stories",
      "prefix": "story-",
      "role": "hierarchy",
      "parents": [["epics"], ["follows"]],
      "placedUnder": "epic",
      "unplacedLabel": "Not placed in an epic",
      "color": { "light": "#d9480f", "dark": "#ffa94d" },
      "chips": [{ "field": "priority", "format": "upper", "tone": "level" }, "lifecycle", { "field": "release" }, "coverage"]
    },
    { "id": "scenario", "label": "Scenario", "plural": "scenarios", "role": "part", "color": { "light": "#c2255c", "dark": "#f783ac" }, "chips": ["verified", "verifyTypes"] },
    { "id": "decision", "label": "Decision", "plural": "decisions", "prefix": "dec-", "role": "linked", "color": { "light": "#495057", "dark": "#adb5bd" }, "chips": ["lifecycle", { "field": "decidedOn", "template": "decided {value}", "slice": 10 }] },
    {
      "id": "standard",
      "label": "Standard",
      "plural": "standards",
      "prefix": "std-",
      "role": "linked",
      "parents": [["issuedBy"]],
      "color": { "light": "#9c36b5", "dark": "#da77f2" },
      "citation": { "source": "body.id", "name": "body.short", "subtitle": "body.title", "parts": [{ "field": "clause", "prefix": "Clause " }, { "field": "item", "wrap": "()" }] },
      "chips": [{ "field": "clause", "template": "Clause {value}" }]
    },
    { "id": "body", "label": "Body", "plural": "bodies", "role": "linked", "color": { "light": "#0b7285", "dark": "#66d9e8" }, "chips": [] },
    { "id": "source", "label": "Source", "plural": "sources", "prefix": "src-", "role": "linked", "color": { "light": "#2b8a3e", "dark": "#8ce99a" }, "chips": [] },
    { "id": "test", "label": "Test", "plural": "tests", "role": "check", "color": { "light": "#6c757d", "dark": "#ced4da" }, "chips": ["checkType"] }
  ],
  "edges": {
    "products": { "labels": ["In product", "Contains"], "down": true },
    "epics": { "labels": ["In epic", "Contains"], "down": true },
    "follows": { "labels": ["Follows", "Followed by"], "down": true },
    "issuedBy": { "labels": ["Issued by", "Issues"], "down": true },
    "complies": {
      "labels": ["Complies with", "Complied with by"],
      "iri": "ex:compliesWith",
      "target": "std",
      "from": ["story"],
      "to": ["standard"],
      "properties": { "since": { "type": "date", "required": true, "iri": "ex:since" }, "audited": { "type": "boolean" } }
    },
    "notes": {
      "labels": ["Notes", "Noted by"],
      "from": ["decision"],
      "to": ["epic", "story"],
      "properties": { "since": { "type": "date" }, "share": { "type": "number" }, "force": { "type": "string", "vocabulary": "force" } }
    },
    "replacedBy": { "labels": ["Replaced by", "Replaces"] },
    "scenario": { "labels": ["Scenario of", "Has scenario"], "down": true },
    "tested": { "labels": ["Tested by", "Tests"] }
  },
  "links": ["complies"],
  "refs": { "field": "notes", "target": "ref", "note": "text" },
  "supersededBy": "replacedBy",
  "linkedScopeEdges": ["complies", "notes"],
  "parts": [{ "kind": "scenario", "owner": "story", "field": "scenarios", "id": "key", "text": "text", "edge": "scenario", "sectionTitle": "Scenarios" }],
  "embedded": [{ "owner": "standard", "field": "body", "kind": "body", "id": "id", "edge": "issuedBy" }],
  "checks": {
    "kind": "test",
    "field": "tests",
    "edge": "tested",
    "typeField": "type",
    "types": {
      "unit": { "key": ["file", "name"], "title": ["name", "short", "title"] },
      "manual": { "key": ["plan"], "title": ["plan"], "titlePrefix": "manual" }
    },
    "sectionTitle": "Tests",
    "noneText": "No test."
  },
  "status": {
    "label": "Result",
    "field": "result",
    "values": [
      { "value": "pass", "label": "Pass", "tone": "good" },
      { "value": "partial", "label": "Partial", "tone": "warn" },
      { "value": "fail", "label": "Fail", "tone": "bad" }
    ],
    "detail": { "field": "openBrowsers", "label": "Open on" }
  },
  "vocabularies": {
    "priority": {
      "label": "Priority",
      "definition": "How soon a story must be done.",
      "concepts": [
        { "code": "low", "label": "Low", "definition": "The story can wait for a later release.", "order": 3 },
        { "code": "medium", "label": "Medium", "definition": "The story is planned for the next releases.", "order": 2 },
        { "code": "high", "label": "High", "definition": "The story blocks a release.", "order": 1 }
      ]
    },
    "lifecycle": {
      "label": "Lifecycle",
      "definition": "Where a node is in its life.",
      "concepts": [
        { "code": "planned", "label": "Planned", "definition": "The team has not started the work.", "order": 1 },
        { "code": "active", "label": "Active", "definition": "The team works on it.", "order": 2 },
        { "code": "dropped", "label": "Dropped", "definition": "The team stopped the work and does not plan to resume it.", "order": 3 },
        { "code": "replaced", "label": "Replaced", "definition": "Another node took its place.", "altLabels": ["superseded"], "order": 4 }
      ]
    },
    "how": {
      "label": "How",
      "definition": "How a fact was obtained.",
      "concepts": [
        { "code": "verified", "label": "Read in a source", "definition": "Someone read the fact in the source.", "order": 1 },
        { "code": "inferred", "label": "Inferred", "definition": "Someone worked the fact out from other facts.", "order": 2 },
        { "code": "reported", "label": "Reported by a person", "definition": "A person told the fact.", "order": 3 }
      ]
    },
    "force": {
      "label": "Force",
      "definition": "How strongly a decision binds the node it notes.",
      "concepts": [
        { "code": "mandatory", "label": "Mandatory", "definition": "The node must follow the decision." },
        { "code": "advisory", "label": "Advisory", "definition": "The node should follow the decision." }
      ]
    }
  },
  "fieldVocabularies": { "priority": "priority", "status": "lifecycle" },
  "provenance": {
    "label": "How known",
    "marker": { "field": "how", "vocabulary": "how" },
    "source": { "field": "source", "kind": "source" },
    "retrieved": "retrieved",
    "agent": "agent",
    "note": "remark",
    "requireSource": ["verified"]
  },
  "fieldFilters": [{ "field": "teams", "label": "Team", "values": { "web": "Web shop" } }, { "field": "priority", "label": "Priority" }, { "field": "basis", "label": "Basis", "from": "keys", "values": { "law": "Law", "contract": "Contract" } }],
  "facets": { "groupKind": "epic", "groupLabel": "Epic" },
  "entry": { "kind": "epic", "childKind": "story", "title": "Pick an epic to see what it contains", "countLabel": "stories" },
  "groups": { "hierarchy": "Product tree" },
  "layout": { "default": "grouped", "groupEdge": "epics" },
  "details": {
    "properties": [
      { "label": "Status", "field": "status" },
      { "label": "Release", "field": "release" },
      { "label": "Priority", "field": "priority", "format": "upper" },
      { "label": "Owner", "field": "owner" }
    ],
    "statementTitle": { "standard": "Quoted clause", "scenario": "Scenario", "default": "Summary" },
    "textSections": [{ "title": "Rationale", "field": "rationale" }],
    "taggedLists": [{ "title": "Basis", "field": "basis", "labels": { "law.region": "Region", "contract": "Contract" } }],
    "citations": [
      {
        "kind": "standard",
        "title": "Citation",
        "rows": [
          { "label": "Link", "path": "url", "link": true }
        ],
        "anchor": "clause",
        "url": "url"
      }
    ]
  }
}
