{
  "project": "Music glossary",
  "iri": { "prefixes": { "ex": "https://example.org/ns/" } },
  "source": { "nodes": "entries", "id": "id", "kind": "type", "defaultKind": "term" },
  "fields": {
    "title": ["term", "name"],
    "idPrefixPattern": "^[a-z]+-",
    "statement": ["definition"]
  },
  "lifecycle": { "field": "state", "fallback": "stable", "states": { "retired": { "muted": true }, "replaced": { "muted": true } } },
  "kinds": [
    { "id": "group", "label": "Group", "plural": "groups", "prefix": "grp-", "role": "hierarchy", "color": { "light": "#1971c2", "dark": "#74c0fc" }, "chips": ["lifecycle", "members"] },
    { "id": "term", "iri": "ex:Term", "label": "Term", "plural": "terms", "role": "hierarchy", "parents": [["inGroup"]], "color": { "light": "#d9480f", "dark": "#ffa94d" }, "chips": ["lifecycle"] }
  ],
  "edges": {
    "inGroup": { "iri": "ex:memberOf", "labels": ["In group", "Contains"], "down": true, "from": ["term"], "to": ["group"] },
    "relations": {
      "labels": ["Relates to", "Related from"],
      "from": ["term"],
      "to": ["term"],
      "properties": { "weight": { "type": "number", "required": true }, "since": { "type": "date" }, "role": { "type": "string", "vocabulary": "role" } }
    }
  },
  "vocabularies": {
    "state": { "file": "vocabularies/state.yaml" },
    "method": {
      "label": "Method",
      "definition": "How an editor learned a fact.",
      "concepts": [
        { "code": "quoted", "label": "Quoted from a text", "definition": "The editor copied the fact from a text.", "order": 1 },
        { "code": "derived", "label": "Worked out by the editor", "definition": "The editor reached the fact from other facts.", "order": 2 },
        { "code": "told", "label": "Told by a person", "definition": "A person told the editor.", "order": 3 }
      ]
    },
    "role": {
      "label": "Role",
      "definition": "What a term does for the term it relates to.",
      "concepts": [
        { "code": "basis", "label": "Basis", "definition": "The other term builds on this term." },
        { "code": "contrast", "label": "Contrast", "definition": "The other term is the opposite of this term." }
      ]
    }
  },
  "fieldVocabularies": { "state": "state" },
  "provenance": {
    "marker": { "field": "method", "vocabulary": "method" },
    "source": { "field": "cite" },
    "retrieved": "seen",
    "agent": "editor",
    "requireSource": ["quoted"]
  },
  "refs": { "field": "relations", "target": "to", "note": "relation" },
  "layout": { "default": "force" },
  "embedded": [{ "owner": "term", "field": "owner", "kind": "group", "edge": "inGroup" }],
  "fieldFilters": [{ "field": "origin", "label": "Origin", "from": "keys", "values": { "theory": "Theory book", "primer": "Primer", "house": "House note" } }],
  "details": {
    "properties": [{ "label": "State", "field": "state" }],
    "statementTitle": { "default": "Definition" },
    "sourceSections": [{ "title": "Sources", "field": "source", "name": "title", "section": "page", "url": "url" }],
    "taggedLists": [
      {
        "title": "Origin",
        "field": "origin",
        "labels": { "theory.area": "Area", "primer.kind": "Primer kind", "primer.chapter": "Primer chapter", "house": "House note" }
      }
    ]
  }
}
