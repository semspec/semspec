{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./packages/app/src/*"],
      "@semspec/core": ["./packages/core/src/index.ts"],
      "@semspec/app/*": ["./packages/app/src/*"]
    }
  },
  "include": ["packages/*/src", "packages/app/vite.config.ts", "packages/cli/scripts", "test", "vitest.config.ts"]
}
