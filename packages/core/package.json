{
  "name": "@semspec/core",
  "version": "0.1.0",
  "description": "The framework-free logic of Semspec: model, scope, walk, casing, CSV and export.",
  "license": "Apache-2.0",
  "author": "The Semspec Authors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
