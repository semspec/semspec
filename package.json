{
  "name": "semspec",
  "version": "0.2.0",
  "description": "AI-native requirements engineering harness.",
  "license": "Apache-2.0",
  "author": "The Semspec Authors",
  "type": "module",
  "bin": {
    "semspec": "bin/semspec.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "bin",
    "packages/app/dist",
    "packages/cli/dist",
    "schema",
    "LICENSE",
    "NOTICE",
    "AUTHORS",
    "README.md"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "prepare": "npm run build",
    "build:core": "npm run build -w @semspec/core",
    "build:app": "npm run build -w @semspec/app",
    "build:cli": "npm run build -w @semspec/cli",
    "build": "npm run build:core && npm run build:app && npm run build:cli",
    "typecheck": "tsc --noEmit && npm run typecheck -w @semspec/core",
    "test": "vitest run",
    "test:time": "node scripts/test-time.mjs",
    "licences": "node scripts/check-licences.mjs",
    "eval:search": "node bin/semspec.js eval-search",
    "requirements": "node bin/semspec.js serve --graph requirements/graph --profile requirements/profile.yaml",
    "requirements:build": "node bin/semspec.js build --graph requirements/graph --profile requirements/profile.yaml --out dist/requirements.html",
    "version": "changeset version && node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
