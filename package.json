    "dist",
    "schema",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build:app": "vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "build": "npm run build:app && npm run build:cli",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
