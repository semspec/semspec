{
  "name": "requirement-explorer",
  "version": "0.1.0",
  "description": "A schema-driven explorer for requirement graphs: a hierarchy tree, a scope by any node, a walk by expansion, Graph, Cards and Table views.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "requirement-explorer": "bin/requirement-explorer.js"
  },
