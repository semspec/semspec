{
  "name": "semspec",
  "version": "0.1.0",
  "description": "AI-native requirements engineering harness.",
  "license": "Apache-2.0",
  "author": "The Semspec Authors",
  "type": "module",
  "bin": {
    "semspec": "bin/semspec.js"
  },
  "files": [
    "bin",
    "dist/app",
    "dist/cli",
    "schema",
    "LICENSE",
    "NOTICE",
    "AUTHORS",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "npm run build",
    "build:app": "vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "build": "npm run build:app && npm run build:cli",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "requirements": "node bin/semspec.js serve --graph requirements/graph --profile requirements/profile.yaml",
    "requirements:build": "node bin/semspec.js build --graph requirements/graph --profile requirements/profile.yaml --out dist/requirements.html"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@dagrejs/dagre": "3.1.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-table": "8.21.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.15.0",
    "shadcn": "4.23.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "4.1.11"
  }
}
